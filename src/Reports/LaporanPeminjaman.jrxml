	<queryString language="SQL">
		<![CDATA[SELECT
    p.Id_Pinjam,
    p.Nis,
    a.Nama,
    dp.Id_Buku,
    p.Tanggal_Pinjam,
    p.Tanggal_Kembali,
    COALESCE(pg.tgl_pengembalian,'-') AS Dikembalikan,
    dp.status_pinjam,
    COALESCE(pg.point,0) AS Denda
FROM peminjaman p
INNER JOIN data_anggota a
    ON p.Nis = a.Nis
INNER JOIN detail_pinjam dp
    ON p.Id_Pinjam = dp.Id_Pinjam
LEFT JOIN pengembalian pg
    ON p.Id_Pinjam = pg.id_peminjaman
ORDER BY p.Tanggal_Pinjam DESC;]]>
	</queryString>
