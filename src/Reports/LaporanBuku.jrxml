	<parameter name="parameter1" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    b.Id_Buku,
    b.Judul_Buku,
    b.Pengarang,
    b.Tahun_Terbit,
    b.Stok,
    b.Jumlah_Halaman,
    p.id_penerbit,
    p.nama_penerbit,
    p.situs
FROM buku b
INNER JOIN penerbit p
    ON b.id_penerbit = p.id_penerbit
ORDER BY
    p.nama_penerbit ASC,
    b.Judul_Buku ASC;]]>
	</queryString>
