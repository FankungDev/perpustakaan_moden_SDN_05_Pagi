	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idKelas" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    da.Nis AS data_anggota_nis,
    da.Nama AS data_anggota_nama,
    da.Email AS data_anggota_email,
    da.Jenis_Kelamin AS data_anggota_jenis_kelamin,
    da.Tanggal_Bergabung AS data_anggota_tanggal_bergabung,
    dk.Kelas AS data_kelas
FROM data_anggota da
INNER JOIN data_kelas dk
    ON da.Id_Kelas = dk.Id_Kelas
WHERE
    ($P{idKelas} IS NULL OR da.Id_Kelas = $P{idKelas})
ORDER BY
    dk.Kelas ASC,
    da.Nama ASC;]]>
	</queryString>
	<field name="data_anggota_nis" class="java.lang.String"/>
	<field name="data_anggota_nama" class="java.lang.String"/>
	<field name="data_anggota_email" class="java.lang.String"/>
	<field name="data_anggota_jenis_kelamin" class="java.lang.String"/>
	<field name="data_anggota_tanggal_bergabung" class="java.sql.Timestamp"/>
	<field name="data_kelas" class="java.lang.String"/>
