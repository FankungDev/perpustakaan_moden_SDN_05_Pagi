	<property name="ireport.zoom" value="1.7715610000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tanggalMulai" class="java.util.Date"/>
	<parameter name="tanggalAkhir" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT

     data_anggota.`nis` AS data_anggota_nis,

     data_anggota.`Nama` AS data_anggota_Nama,

     data_anggota.`Email` AS data_anggota_email,

     data_anggota.`Jenis_Kelamin` AS data_anggota_Jenis_Kelamin,

     data_anggota.`Tanggal_Bergabung` AS data_anggota_tanggal_bergabung

FROM

     `data_anggota` data_anggota

WHERE 

     ($P{tanggalMulai} IS NULL OR data_anggota.`Tanggal_Bergabung` >= $P{tanggalMulai})

     AND ($P{tanggalAkhir} IS NULL OR data_anggota.`Tanggal_Bergabung` <= $P{tanggalAkhir})]]>
	</queryString>
	<field name="data_anggota_nis" class="java.lang.String"/>
	<field name="data_anggota_Nama" class="java.lang.String"/>
	<field name="data_anggota_email" class="java.lang.String"/>
	<field name="data_anggota_Jenis_Kelamin" class="java.lang.String"/>
	<field name="data_anggota_tanggal_bergabung" class="java.sql.Timestamp"/>
